# Copy to .env.local and fill in. On Vercel, set these under Project > Settings > Environment Variables.

# Where the FastAPI backend runs. Server-side only; browsers never call it directly.
QREADER_API_URL=http://127.0.0.1:8000

# Must match API_KEY in the backend's environment.
QREADER_API_KEY=

# Signs staff session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=
