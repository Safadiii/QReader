# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL connection string.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/qreader

# Shared secret with the web app (its QREADER_API_KEY must be the same value).
# Generate one with: openssl rand -hex 32
API_KEY=

# What every QR code points at: the public web address + /track.
# Must be https:// anywhere except localhost.
TRACKING_BASE_URL=http://localhost:3000/track

# How long a QR link stays valid, in minutes (default 1440 = one day).
QR_TTL_MINUTES=1440

# --- Push notifications (optional; the app works without them) ---

# iPhone (App Clip) pushes, from your Apple Developer account:
# Certificates, Identifiers & Profiles > Keys > create a key with "Apple Push Notifications service".
APNS_KEY_ID=
APNS_TEAM_ID=
# The App Clip's bundle id, e.g. com.yourname.qreader.Clip
APNS_BUNDLE_ID=
# The full text of the downloaded .p8 file. On one line, write line breaks as \n.
APNS_PRIVATE_KEY=

# Browser pushes (Android). Generate a key pair once with:
#   python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.private_pem().decode())"
VAPID_PRIVATE_KEY=
# A contact address the push services can reach you at, e.g. mailto:you@example.com
VAPID_SUBJECT=
